<!-- views/chambres/edit.ejs -->
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>


    <!-- Semantic UI -->
    <link rel="stylesheet" href="/semantic-ui/semantic.min.css">

    <!-- CSS CUSTOM (IMPORTANT) -->
    <link rel="stylesheet" href="/stylenuit.css">
</head>

<body>
    <div class="stars"></div>
    <div class="moon"></div>
    <div class="hero-section">
        <div class="palm-left">🌴</div>
        <div class="palm-right">🌴</div>
        <div class="hero-content">
            <div>
                <a href="/" class="hotel-title-link">
                    <h1 class="hotel-name" >Hôtel California</h1>
                </a>
            </div>
            <div>
                <a href="/chambres" class="hotel-title-link">
                    <p class="hotel-tagline">Liste des chambres</p>
                </a>
            </div>
            <% if (errors && errors.length> 0) { %>
                <div class="ui negative message">
                    <div class="header">Erreur lors de la modification</div>
                    <ul class="list">
                        <% errors.forEach(error=> { %>
                            <li>
                                <%= error.msg %>
                            </li>
                            <% }) %>
                    </ul>
                </div>
            <% } %>

            <div class="table-wrapper">
                <form class="chambres-table" action="/chambres/<%= chambre.id %>" method="POST">
                    <!-- ID caché (optionnel mais utile) -->
                    <input type="hidden" name="id" value="<%= chambre.id %>">
                    <div class="two fields">
                        <div class="required field">
                            <label>Numéro de la chambre</label>
                            <input
                                type="text"
                                name="numero"
                                value="<%= chambre.numero %>"
                                required 
                                >       <!--Fin de l'input, pas trop intuitif juste un ">" -->
                        </div>
                        <div class="required field">
                            <label>Capacité</label>
                            <select class="ui dropdown" name="capacite" required>
                                <option value="1" <%= chambre.capacite == 1 ? 'selected' : '' %>>1 personne</option>
                                <option value="2" <%= chambre.capacite == 2 ? 'selected' : '' %>>2 personnes</option>
                                <option value="3" <%= chambre.capacite == 3 ? 'selected' : '' %>>3 personnes</option>
                                <option value="4" <%= chambre.capacite == 4 ? 'selected' : '' %>>4 personnes</option>
                                <option value="5" <%= chambre.capacite == 5 ? 'selected' : '' %>>5 personnes</option>
                                <option value="6" <%= chambre.capacite == 6 ? 'selected' : '' %>>6 personnes</option>
                            </select>
                        </div>
                    </div>
                    <div class="ui divider"></div>
                    <div class="field" style="text-align: right;">
                        <a href="/chambres" class="ui button">
                            <i class="cancel icon"></i> Annuler
                        </a>
                        <button class="ui primary button" type="submit">
                            <i class="save icon"></i> Modifier la chambre
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer">
        <div class="ui container">
            <div style="text-align: center; padding: 20px 0;">
                <p>© 2025 Hôtel California. Tous droits réservés.</p>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/2.5.0/semantic.min.js"></script>
    <script>
        $('.ui.dropdown').dropdown();
    </script>
</body>

</html>